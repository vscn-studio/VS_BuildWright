<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ImGuiDirectory Condition="'$(ImGuiDirectory)' == ''">$(MSBuildProjectDirectory)\..\..\..\vsimgui_1.2.7</ImGuiDirectory>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\..\Client\BuildwrightImGuiInput.cs" Link="BuildwrightImGuiInput.cs" />
    <Reference Include="ImGui.NET" HintPath="$(ImGuiDirectory)\ImGui.NET.dll" />
    <None Include="$(ImGuiDirectory)\native\win\cimgui.dll" Link="cimgui.dll" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
