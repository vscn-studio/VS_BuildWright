<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="ImGuiSmoke\**\*.cs" />
    <ProjectReference Include="..\Buildwright.csproj" />
    <Reference Include="Newtonsoft.Json" HintPath="$(VINTAGE_STORY)\Lib\Newtonsoft.Json.dll" Private="true" />
    <Reference Include="VintagestoryAPI" HintPath="$(VINTAGE_STORY)\VintagestoryAPI.dll" Private="true" />
    <Reference Include="VintagestoryLib" HintPath="$(VINTAGE_STORY)\VintagestoryLib.dll" Private="true" />
    <Reference Include="OpenTK.Windowing.Common" HintPath="$(VINTAGE_STORY)\Lib\OpenTK.Windowing.Common.dll" Private="true" />
    <Reference Include="OpenTK.Mathematics" HintPath="$(VINTAGE_STORY)\Lib\OpenTK.Mathematics.dll" Private="true" />
    <Reference Include="OpenTK.Windowing.GraphicsLibraryFramework" HintPath="$(VINTAGE_STORY)\Lib\OpenTK.Windowing.GraphicsLibraryFramework.dll" Private="true" />
    <Reference Include="VSSurvivalMod" HintPath="$(VINTAGE_STORY)\Mods\VSSurvivalMod.dll" Private="true" />
    <Reference Include="protobuf-net" HintPath="$(VINTAGE_STORY)\Lib\protobuf-net.dll" Private="true" />
  </ItemGroup>
</Project>
